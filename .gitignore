# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-guide-convention.html#cargo-lock
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Vim/Emacs swap files
*.swp
*~
\#*#

# macOS
.DS_Store

# IDEs
.idea/
.vscode/
*.iml

# Project specific temporary files
check_output.txt
check_warnings.txt
check_warnings_*.txt
test_results.txt

# NNUE weight files at the repo root: the trainer writes checkpoints there by
# default. The shipped network is nnue/default.bin (Git LFS, .gitattributes).
nnue_weights_*.bin
nnue_weights_*.json
elo_results.csv
nnue_corpus_*.jsonl

# Kept on disk but not in git (docs/REPOSITORY.md): training corpora, network
# checkpoints, local engine builds, match logs, generated tables. Ignored files are
# still deleted by `git clean -x` -- never run it in a working copy that holds data.
/corpus_*/
/engines/
/weights/*
!/weights/archive/
/matches/*
!/matches/user_games/
/resources/magic_tables/magic_table.bin
/usi_match.csv
/.claude/scheduled_tasks.lock
/.claude/settings.local.json
