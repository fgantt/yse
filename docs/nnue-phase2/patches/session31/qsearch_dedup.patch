+    /// Quiescence lists hold each move once, keep both versions of a silver,
+    /// knight or lance promotion, and drop the non-promoting version of a
+    /// pawn, bishop or rook move when the promoting one is there.
+    #[test]
+    fn quiescence_dedup_respects_promotion() {
+        use rand::{seq::SliceRandom, SeedableRng};
+        let mg = MoveGenerator::new();
+        let mut rng = rand::rngs::StdRng::seed_from_u64(34);
+        let minor = |p: PieceType| matches!(p, PieceType::Silver | PieceType::Knight | PieceType::Lance);
+        let (mut minor_pairs, mut positions) = (0usize, 0usize);
+        for _ in 0..30 {
+            let mut board = BitboardBoard::new();
+            let mut captured = CapturedPieces::new();
+            let mut player = Player::Black;
+            for _ in 0..160 {
+                let got = mg.generate_quiescence_moves_bounded(&board, player, &captured, true);
+                let usi: Vec<String> = got.iter().map(Move::to_usi_string).collect();
+                let captures: Vec<String> = mg
+                    .generate_legal_captures(&board, player, &captured)
+                    .iter()
+                    .map(Move::to_usi_string)
+                    .collect();
+                for (i, u) in usi.iter().enumerate() {
+                    assert!(!usi[..i].contains(u), "{u} twice: {}", board.to_fen(player, &captured));
+                }
+                for m in got.iter().filter(|m| m.is_promotion && m.from.is_some()) {
+                    let plain = m.to_usi_string().trim_end_matches('+').to_string();
+                    // (Promotions come from the pseudo-legal list, so `m` itself
+                    // need not be legal; its twin is required only if it is.)
+                    if minor(m.piece_type) && captures.contains(&plain) {
+                        assert!(usi.contains(&plain), "{plain} lost: {}", board.to_fen(player, &captured));
+                        minor_pairs += 1;
+                    } else if !minor(m.piece_type) {
+                        assert!(!usi.contains(&plain), "{plain} kept: {}", board.to_fen(player, &captured));
+                    }
+                }
+                positions += 1;
+                let legal = mg.generate_legal_moves(&board, player, &captured);
+                let Some(m) = legal.choose(&mut rng) else { break };
+                board.make_move_with_hand(m, &mut captured);
+                player = player.opposite();
+            }
+        }
+        assert!(minor_pairs > 20 && positions > 1000, "{minor_pairs} {positions}");
+    }
+
