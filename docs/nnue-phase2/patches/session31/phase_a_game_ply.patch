+/// Plies played in the current game before the position being searched: the
+/// SFEN move number minus one, plus the moves after it in `position`. The move
+/// orderer picks its phase strategy from this. Process-wide, because an engine
+/// plays one game and every search thread needs it.
+static GAME_PLY: AtomicUsize = AtomicUsize::new(0);
+
+pub fn set_game_ply(ply: usize) {
+    GAME_PLY.store(ply, Ordering::Relaxed);
+}
+
+fn game_ply() -> usize {
+    GAME_PLY.load(Ordering::Relaxed)
+}
