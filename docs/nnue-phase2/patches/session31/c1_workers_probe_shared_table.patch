+    /// Probe the table this engine stores into: the shared table when one is
+    /// set (parallel workers), else its own.
+    ///
+    /// Stores go to the shared table whenever one is set, but every probe used
+    /// to read the engine's own table -- which, for a worker, never received an
+    /// entry. Parallel workers searched with no transposition-table cutoffs at
+    /// all; only the move orderer looked at the shared table.
+    #[inline]
+    fn tt_probe(&self, hash: u64, depth: u8) -> Option<TranspositionEntry> {
+        if let Some(ref shared_tt) = self.shared_transposition_table {
+            if let Ok(tt) = shared_tt.try_read() {
+                return tt.probe_with_prefetch(hash, depth, None);
+            }
+        }
+        self.transposition_table.probe_with_prefetch(hash, depth, None)
+    }
