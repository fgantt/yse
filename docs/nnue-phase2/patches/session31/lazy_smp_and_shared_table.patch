diff --git a/src/search/lazy_smp.rs b/src/search/lazy_smp.rs
new file mode 100644
index 0000000..a707f97
--- /dev/null
+++ b/src/search/lazy_smp.rs
@@ -0,0 +1,211 @@
+//! Lazy SMP: helper threads search the whole tree from the root alongside the
+//! main thread, sharing only the transposition table.
+//!
+//! The root-splitting parallel search searched the first root move alone and
+//! the others only after it, and only from depth 5; a profile of the shipped
+//! engine found its workers asleep 52-85% of the time. It also built a new
+//! thread pool and a new 4M-entry shared table for every move. Here the helper
+//! threads and the table live as long as the engine: each move, every helper
+//! runs its own iterative deepening on the root position until the main search
+//! ends. Only the main thread chooses the move; helpers contribute through the
+//! table, where their entries cut the main thread's search short.
+//!
+//! A `SearchEngine` cannot move between threads, so each helper builds its own
+//! search context inside its thread, once, and keeps it.
+
+use crate::bitboards::BitboardBoard;
+use crate::evaluation::nnue::NNUEEvaluator;
+use crate::search::parallel_search::ThreadLocalSearchContext;
+use crate::search::search_engine::{MAX_SCORE, MIN_SCORE};
+use crate::search::{ThreadSafeTranspositionTable, TranspositionConfig};
+use crate::types::board::CapturedPieces;
+use crate::types::core::{Move, Player};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::thread;
+
+/// One move's work for a helper.
+struct Job {
+    board: BitboardBoard,
+    captured: CapturedPieces,
+    player: Player,
+    /// First depth; helpers alternate between 1 and 2 so they do not all walk
+    /// the same tree in step.
+    first_depth: u8,
+    /// A new network when the main engine's differs from the helper's.
+    nnue: Option<Option<NNUEEvaluator>>,
+    stop: Arc<AtomicBool>,
+    done: mpsc::Sender<()>,
+    best: Arc<Mutex<Option<Completed>>>,
+}
+
+/// A helper's deepest fully completed iteration: (depth, move, score).
+pub type Completed = (u8, Move, i32);
+
+struct Helper {
+    jobs: mpsc::Sender<Job>,
+    network: Option<Option<u64>>,
+}
+
+/// The helper threads and the shared transposition table.
+pub struct LazySmp {
+    table: Arc<ThreadSafeTranspositionTable>,
+    helpers: Mutex<Vec<Helper>>,
+}
+
+/// A running search's helpers. Dropping it stops them and waits until each
+/// has returned to idle, so no helper outlives the move it was searching.
+pub struct LazySearch {
+    stop: Arc<AtomicBool>,
+    done: mpsc::Receiver<()>,
+    running: usize,
+    best: Arc<Mutex<Option<Completed>>>,
+}
+
+impl LazySearch {
+    /// Stop the helpers, wait for them, and return the deepest iteration any
+    /// of them completed. As in Stockfish and YaneuraOu, the move comes from
+    /// the deepest completed search, not always the main thread's: helpers
+    /// started a ply deeper often finish an iteration the main thread does not.
+    pub fn finish(mut self) -> Option<Completed> {
+        self.stop_and_wait();
+        self.best.lock().ok().and_then(|b| b.clone())
+    }
+
+    fn stop_and_wait(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        for _ in 0..std::mem::take(&mut self.running) {
+            if self.done.recv().is_err() {
+                break;
+            }
+        }
+    }
+}
+
+impl Drop for LazySearch {
+    fn drop(&mut self) {
+        self.stop_and_wait();
+    }
+}
+
+impl LazySmp {
+    /// `helpers` threads (the main thread is extra) and a shared table of
+    /// `table_entries` entries.
+    pub fn new(helpers: usize, table_entries: usize) -> Self {
+        let mut config = TranspositionConfig::performance_optimized();
+        config.table_size = table_entries.next_power_of_two();
+        // With statistics on, every probe and store takes a table-wide mutex to
+        // bump a counter: all threads serialise on it. Nothing in the search
+        // reads the counters.
+        config.enable_statistics = false;
+        let mut table = ThreadSafeTranspositionTable::new(config);
+        table.set_lock_free(true);
+        let table = Arc::new(table);
+        let helpers = (0..helpers)
+            .filter_map(|i| {
+                let (tx, rx) = mpsc::channel::<Job>();
+                let table = table.clone();
+                thread::Builder::new()
+                    .name(format!("lazy-smp-{i}"))
+                    .stack_size(8 * 1024 * 1024)
+                    .spawn(move || helper_loop(&rx, &table))
+                    .ok()
+                    .map(|_| Helper { jobs: tx, network: None })
+            })
+            .collect();
+        Self { table, helpers: Mutex::new(helpers) }
+    }
+
+    pub fn helper_count(&self) -> usize {
+        self.helpers.lock().map_or(0, |h| h.len())
+    }
+
+    /// The shared table; the main search engine must store into and probe it.
+    pub fn table(&self) -> Arc<ThreadSafeTranspositionTable> {
+        self.table.clone()
+    }
+
+    /// Start every helper on this position. `network` is the main engine's
+    /// NNUE network id (`None` for classical evaluation); `copy_network`
+    /// supplies a copy for helpers that do not have it yet.
+    pub fn start(
+        &self,
+        board: &BitboardBoard,
+        captured: &CapturedPieces,
+        player: Player,
+        network: Option<u64>,
+        copy_network: impl Fn() -> Option<NNUEEvaluator>,
+    ) -> LazySearch {
+        let stop = Arc::new(AtomicBool::new(false));
+        let best = Arc::new(Mutex::new(None));
+        let (done_tx, done_rx) = mpsc::channel();
+        let mut running = 0;
+        // Diagnostic: the shared table without helpers.
+        let no_helpers = std::env::var_os("SHOGI_LAZY_NO_HELPERS").is_some();
+        if let (Ok(mut helpers), false) = (self.helpers.lock(), no_helpers) {
+            for (i, h) in helpers.iter_mut().enumerate() {
+                let nnue = (h.network != Some(network)).then(&copy_network);
+                let job = Job {
+                    board: board.clone(),
+                    captured: captured.clone(),
+                    player,
+                    first_depth: 1 + (i % 2) as u8,
+                    nnue,
+                    stop: stop.clone(),
+                    done: done_tx.clone(),
+                    best: best.clone(),
+                };
+                if h.jobs.send(job).is_ok() {
+                    h.network = Some(network);
+                    running += 1;
+                }
+            }
+        }
+        LazySearch { stop, done: done_rx, running, best }
+    }
+}
+
+fn helper_loop(jobs: &mpsc::Receiver<Job>, table: &Arc<ThreadSafeTranspositionTable>) {
+    let mut ctx: Option<ThreadLocalSearchContext> = None;
+    while let Ok(job) = jobs.recv() {
+        let c = ctx.get_or_insert_with(|| {
+            // Its own table is never used (probes and stores go to the shared
+            // one), so keep it minimal.
+            let mut c = ThreadLocalSearchContext::new(&job.board, &job.captured, job.player, None, 1);
+            c.search_engine_mut().set_lock_free_table(table.clone());
+            c
+        });
+        if let Some(nnue) = job.nnue {
+            c.search_engine_mut().get_evaluator_mut().install_nnue(nnue);
+        }
+        c.refresh_root_state(&job.board, &job.captured);
+        c.update_stop_flag(Some(job.stop.clone()));
+        let mut depth = job.first_depth;
+        while !job.stop.load(Ordering::Relaxed) && depth < 100 {
+            let engine = c.search_engine_mut();
+            engine.get_evaluator_mut().nnue_refresh(&job.board, job.player, &job.captured);
+            let mut board = job.board.clone();
+            let result = engine.search_at_depth(
+                &mut board,
+                &job.captured,
+                job.player,
+                depth,
+                u32::MAX / 2,
+                MIN_SCORE,
+                MAX_SCORE,
+            );
+            engine.flush_tt_buffer();
+            // Only an iteration that finished before the stop counts.
+            if let (Some((mv, score)), false) = (result, job.stop.load(Ordering::Relaxed)) {
+                if let Ok(mut best) = job.best.lock() {
+                    if best.as_ref().map_or(true, |b| depth > b.0) {
+                        *best = Some((depth, mv, score));
+                    }
+                }
+            }
+            depth += 1;
+        }
+        c.reset_to_root();
+        let _ = job.done.send(());
+    }
+}
