+    /// How many of `attacking_player`'s pieces attack `target_pos` (the count
+    /// version of [`Self::is_square_attacked_by`]). Each piece counts once: a
+    /// dragon is counted by its rook rays orthogonally and its step diagonally,
+    /// a horse the other way round.
+    pub fn attacker_count(&self, target_pos: Position, attacking_player: Player) -> u32 {
+        let a = if attacking_player == Player::Black { 0 } else { 1 };
+        let defender = attacking_player.opposite();
+        let t = target_pos.to_index() as u8;
+        let pcs = |pt: PieceType| self.pieces[a][pt.to_u8() as usize];
+        let ones = |bb: Bitboard| bb.to_u128().count_ones();
+        let mut n = 0;
+        for pt in [
+            PieceType::Pawn,
+            PieceType::Knight,
+            PieceType::Silver,
+            PieceType::Gold,
+            PieceType::PromotedPawn,
+            PieceType::PromotedLance,
+            PieceType::PromotedKnight,
+            PieceType::PromotedSilver,
+        ] {
+            let p = pcs(pt);
+            if !p.is_empty() {
+                n += ones(self.attack_tables.get_attack_pattern(t, pt, defender) & p);
+            }
+        }
+        let adjacent = self.attack_tables.get_attack_pattern(t, PieceType::King, defender);
+        let rook_rays = self.get_attack_pattern(target_pos, PieceType::Rook);
+        let bishop_rays = self.get_attack_pattern(target_pos, PieceType::Bishop);
+        n += ones(adjacent & pcs(PieceType::King));
+        n += ones(adjacent & bishop_rays & pcs(PieceType::PromotedRook));
+        n += ones(adjacent & rook_rays & pcs(PieceType::PromotedBishop));
+        n += ones(rook_rays & (pcs(PieceType::Rook) | pcs(PieceType::PromotedRook)));
+        n += ones(bishop_rays & (pcs(PieceType::Bishop) | pcs(PieceType::PromotedBishop)));
+        let lances = pcs(PieceType::Lance);
+        if !lances.is_empty() {
+            let dir: i8 = if attacking_player == Player::Black { 1 } else { -1 };
+            let mut row = target_pos.row as i8 + dir;
+            while (0..9).contains(&row) {
+                let sq = Position::new(row as u8, target_pos.col);
+                if let Some(p) = self.get_piece(sq) {
+                    if p.player == attacking_player && p.piece_type == PieceType::Lance {
+                        n += 1;
+                    }
+                    break;
+                }
+                row += dir;
+            }
+        }
+        n
+    }
+
